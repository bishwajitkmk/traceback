# Copy to .env and adjust. Never commit real credentials.

# --- Backend ---
TRACEBACK_ENV=development
TRACEBACK_DATABASE_URL=postgresql+psycopg://traceback:traceback@localhost:5432/traceback
TRACEBACK_SECRET_KEY=change-me-to-a-long-random-string
TRACEBACK_CORS_ORIGINS=http://localhost:5180
TRACEBACK_SESSION_TTL_HOURS=168
TRACEBACK_MAX_EVENT_BYTES=262144
# Allows replay to loopback/private addresses for "local" targets. Set true for
# local development (the sample app on 127.0.0.1). Refused when ENV=production.
TRACEBACK_REPLAY_ALLOW_PRIVATE_NETWORKS=false
# Production only: parent domain shared by app and API (e.g. .example.com),
# and the number of reverse proxies in front of the API (Render: 1).
# TRACEBACK_COOKIE_DOMAIN=.example.com
# TRACEBACK_TRUSTED_PROXY_HOPS=1

# --- Postgres (docker compose) ---
POSTGRES_USER=traceback
POSTGRES_PASSWORD=traceback
POSTGRES_DB=traceback

# --- Frontend (public, baked into the build; never put secrets here) ---
VITE_API_BASE_URL=http://localhost:8100/api/v1
