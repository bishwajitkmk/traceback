# Local dev defaults: the frontend talks to the real API on port 8100.
# For an offline demo with no backend, run: VITE_USE_MOCKS=true npm run dev
# (or put VITE_USE_MOCKS=true in .env.development.local).
VITE_USE_MOCKS=false
VITE_API_BASE_URL=http://localhost:8100/api/v1
# Prefill the seeded demo account on /login?demo=1 (python -m app.jobs.seed_demo).
VITE_SHOW_DEMO_LOGIN=true
